# Copia este archivo como .env y complétalo. El archivo .env no se sube al repositorio.

# --- LLM A (analiza la documentación) y LLM B (valida el análisis de A) ---
# Backends posibles:
#   claude_code    sesión iniciada en Claude Code (CLI `claude`)
#   codex          sesión iniciada en Codex (CLI `codex`)
#   anthropic_api  API de Anthropic, usa ANTHROPIC_API_KEY
#   openai_api     API de OpenAI, usa OPENAI_API_KEY
LLM_A_BACKEND=claude_code
LLM_B_BACKEND=codex

# Modelo de cada rol. Vacío = valor por defecto, igual por CLI y por API:
#   claude_code / anthropic_api: claude-opus-5-5
#   codex / openai_api: gpt-6.1-sol
LLM_A_MODEL=
LLM_B_MODEL=

# --- API keys: solo hacen falta para los backends *_api ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
