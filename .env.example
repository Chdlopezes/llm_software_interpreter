# Copia este archivo como .env y complétalo. El archivo .env no se sube al repositorio.

# --- Un LLM por tarea. Cada tarea tiene su propia configuración; ninguna toma la de otra. ---
# Backends posibles:
#   claude_code    sesión iniciada en Claude Code (CLI `claude`)
#   codex          sesión iniciada en Codex (CLI `codex`)
#   anthropic_api  API de Anthropic, usa ANTHROPIC_API_KEY
#   openai_api     API de OpenAI, usa OPENAI_API_KEY
LLM_CLASIFICADOR_BACKEND=claude_code   # fase 0: clasifica cada sección
LLM_VALIDADOR_BACKEND=codex            # fase 0: valida cada clasificación
LLM_GENERADOR_BACKEND=claude_code      # fase 3: genera las conversaciones candidatas
LLM_VERIFICADOR_BACKEND=codex          # fase 3: verifica cada candidato (distinto del generador)
LLM_CORRUPTOR_BACKEND=claude_code      # fase 6: escribe las respuestas con errores deliberados para calibrar al juez
LLM_JUEZ_BACKEND=codex                 # fase 6: evalúa las respuestas del modelo (distinto del generador y del verificador)

# Modelo de cada tarea. Vacío = valor por defecto, igual por CLI y por API:
#   claude_code / anthropic_api: claude-opus-5-5
#   codex / openai_api: gpt-6.1-sol
LLM_CLASIFICADOR_MODEL=
LLM_VALIDADOR_MODEL=
LLM_GENERADOR_MODEL=
LLM_VERIFICADOR_MODEL=
LLM_CORRUPTOR_MODEL=
LLM_JUEZ_MODEL=

# --- API keys: solo hacen falta para los backends *_api ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
