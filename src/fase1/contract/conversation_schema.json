{
  "title": "Conversación de entrenamiento",
  "description": "Formato messages + tools que consume el entrenador. Solo contiene lo que ve y produce el modelo.",
  "type": "object",
  "required": ["tools", "messages"],
  "additionalProperties": false,
  "properties": {
    "tools": {"type": "array", "minItems": 1},
    "messages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": false,
        "properties": {
          "role": {"enum": ["system", "user", "assistant", "tool"]},
          "content": {"type": "string"},
          "name": {"type": "string"},
          "tool_calls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "function"],
              "additionalProperties": false,
              "properties": {
                "type": {"enum": ["function"]},
                "function": {
                  "type": "object",
                  "required": ["name", "arguments"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {"enum": ["obtener_documentacion"]},
                    "arguments": {
                      "type": "object",
                      "required": ["software", "version"],
                      "additionalProperties": false,
                      "properties": {
                        "software": {"type": "string", "minLength": 1},
                        "version": {"type": ["string", "null"]}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
